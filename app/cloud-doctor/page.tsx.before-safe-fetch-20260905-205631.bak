"use client";

import {
  AlertTriangle,
  CheckCircle2,
  ChevronRight,
  Clock3,
  HeartPulse,
  Info,
  Loader2,
  RefreshCw,
  Server,
  ShieldCheck,
  X,
  XCircle,
} from "lucide-react";
import { useCallback, useEffect, useMemo, useState } from "react";

type Finding = {
  id: string;
  service: string;
  severity: "critical" | "warning" | "healthy" | "info";
  title: string;
  description: string;
  recommendation: string;
  affectedResources: number;
  remediationMode: string;
};

type DoctorResponse = {
  success: boolean;
  region: string;
  scannedAt: string;
  summary: {
    score: number;
    totalFindings: number;
    critical: number;
    warnings: number;
    healthy: number;
    info: number;
  };
  infrastructure: {
    ec2: number;
    runningEC2: number;
    stoppedEC2: number;
    s3: number;
    rds: number;
    eks: number;
  };
  findings: Finding[];
};

function severityConfig(severity: Finding["severity"]) {
  switch (severity) {
    case "critical":
      return {
        label: "Critical",
        badge: "border-red-400/20 bg-red-400/10 text-red-300",
        icon: "text-red-400",
        background: "border-red-400/15 bg-red-400/[0.025]",
        Icon: XCircle,
      };

    case "warning":
      return {
        label: "Warning",
        badge: "border-amber-400/20 bg-amber-400/10 text-amber-300",
        icon: "text-amber-400",
        background: "border-amber-400/15 bg-amber-400/[0.025]",
        Icon: AlertTriangle,
      };

    case "healthy":
      return {
        label: "Healthy",
        badge: "border-emerald-400/20 bg-emerald-400/10 text-emerald-300",
        icon: "text-emerald-400",
        background: "border-emerald-400/15 bg-emerald-400/[0.025]",
        Icon: CheckCircle2,
      };

    default:
      return {
        label: "Info",
        badge: "border-cyan-400/20 bg-cyan-400/10 text-cyan-300",
        icon: "text-cyan-400",
        background: "border-cyan-400/15 bg-cyan-400/[0.025]",
        Icon: Info,
      };
  }
}

function scoreConfig(score: number) {
  if (score >= 90) {
    return {
      label: "Excellent",
      description: "Infrastructure is in a strong operational state.",
      className: "text-emerald-300",
      bar: "bg-emerald-400",
    };
  }

  if (score >= 75) {
    return {
      label: "Healthy",
      description: "Minor operational improvements are recommended.",
      className: "text-[#B7D1C5]",
      bar: "bg-[#B7D1C5]",
    };
  }

  if (score >= 50) {
    return {
      label: "Needs Attention",
      description: "OpsMind identified issues that should be reviewed.",
      className: "text-amber-300",
      bar: "bg-amber-400",
    };
  }

  return {
    label: "Critical",
    description: "Immediate infrastructure review is recommended.",
    className: "text-red-300",
    bar: "bg-red-400",
  };
}

export default function CloudDoctorPage() {
  const [data, setData] = useState<DoctorResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");
  const [selected, setSelected] = useState<Finding | null>(null);

  const runScan = useCallback(async (manual = false) => {
    try {
      if (manual) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError("");
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15000);

      const response = await fetch("/api/opsmind/doctor", {
        cache: "no-store",
        signal: controller.signal,
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Cloud Doctor scan failed");
      }

      setData(result);
    } catch (err) {
      console.error("Cloud Doctor scan error:", err);

      setError(
        err instanceof Error
          ? err.message
          : "Cloud Doctor scan failed"
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    runScan();

    const interval = setInterval(() => {
      runScan();
    }, 30000);

    return () => clearInterval(interval);
  }, [runScan]);

  const findings = data?.findings ?? [];

  const score = data?.summary.score ?? 0;
  const scoreState = scoreConfig(score);

  const sortedFindings = useMemo(() => {
    const priority: Record<Finding["severity"], number> = {
      critical: 0,
      warning: 1,
      info: 2,
      healthy: 3,
    };

    return [...findings].sort(
      (a, b) => priority[a.severity] - priority[b.severity]
    );
  }, [findings]);

  return (
    <main className="min-h-screen bg-[#040404] px-4 py-6 text-[#F6E8DF] sm:px-6 lg:px-10">
      <div className="mx-auto max-w-7xl">

        {/* Header */}
        <header className="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <div className="mb-3 flex items-center gap-2 text-[#B7D1C5]">
              <div className="flex h-8 w-8 items-center justify-center rounded-lg border border-[#B7D1C5]/20 bg-[#B7D1C5]/10">
                <HeartPulse size={16} />
              </div>

              <span className="text-xs font-semibold uppercase tracking-[0.25em]">
                Intelligence / Cloud Doctor
              </span>
            </div>

            <h1 className="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
              Cloud Doctor.
            </h1>

            <p className="mt-3 max-w-2xl text-sm leading-6 text-[#9B9B9B]">
              Live AWS infrastructure diagnostics, health scoring and
              remediation recommendations powered by OpsMind.
            </p>

            {data?.region && (
              <div className="mt-4 inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.025] px-3 py-2 text-xs text-[#777C85]">
                AWS Region
                <span className="font-mono text-[#B7D1C5]">
                  {data.region}
                </span>
              </div>
            )}
          </div>

          <button
            onClick={() => runScan(true)}
            disabled={loading || refreshing}
            className="flex items-center justify-center gap-2 rounded-xl border border-[#B7D1C5]/20 bg-[#B7D1C5]/10 px-4 py-3 text-sm font-semibold text-[#B7D1C5] transition hover:bg-[#B7D1C5]/15 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {refreshing ? (
              <Loader2 className="h-4 w-4 animate-spin" />
            ) : (
              <RefreshCw className="h-4 w-4" />
            )}

            {refreshing ? "Scanning..." : "Run Diagnostic Scan"}
          </button>
        </header>

        {/* Error */}
        {error && (
          <section className="mt-8 rounded-2xl border border-red-400/20 bg-red-400/[0.04] p-5">
            <div className="flex items-start gap-3">
              <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0 text-red-400" />

              <div>
                <h2 className="font-semibold text-red-300">
                  Diagnostic Error
                </h2>

                <p className="mt-1 text-sm leading-6 text-[#9B9B9B]">
                  {error}
                </p>
              </div>
            </div>
          </section>
        )}

        {/* Initial Loading */}
        {loading && !data && (
          <section className="mt-8 rounded-2xl border border-white/10 bg-white/[0.025] p-12 text-center sm:p-16">
            <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-[#B7D1C5]/20 bg-[#B7D1C5]/10">
              <Loader2 className="h-7 w-7 animate-spin text-[#B7D1C5]" />
            </div>

            <h2 className="mt-5 text-lg font-semibold">
              Diagnosing AWS infrastructure...
            </h2>

            <p className="mt-2 text-sm text-[#777C85]">
              OpsMind is analysing the current infrastructure state.
            </p>
          </section>
        )}

        {data && (
          <>
            {/* Health Overview */}
            <section className="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-[1.35fr_1fr]">

              <div className="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025]">
                <div className="border-b border-white/10 px-5 py-5 sm:px-6">
                  <div className="flex items-center justify-between gap-4">
                    <div>
                      <p className="text-xs uppercase tracking-[0.2em] text-[#777C85]">
                        Infrastructure Health
                      </p>

                      <h2 className="mt-2 text-xl font-bold sm:text-2xl">
                        Overall Diagnostic Score
                      </h2>
                    </div>

                    <div className="flex h-10 w-10 items-center justify-center rounded-xl border border-[#B7D1C5]/15 bg-[#B7D1C5]/[0.06]">
                      <ShieldCheck className="h-5 w-5 text-[#B7D1C5]" />
                    </div>
                  </div>
                </div>

                <div className="p-5 sm:p-6">
                  <div className="flex items-end gap-3">
                    <span className="text-6xl font-bold tracking-tight">
                      {score}
                    </span>

                    <span className="mb-2 text-sm text-[#777C85]">
                      / 100
                    </span>
                  </div>

                  <p className={`mt-2 text-sm font-semibold ${scoreState.className}`}>
                    {scoreState.label}
                  </p>

                  <p className="mt-1 text-xs leading-5 text-[#777C85]">
                    {scoreState.description}
                  </p>

                  <div className="mt-6 h-2.5 overflow-hidden rounded-full bg-white/5">
                    <div
                      className={`h-full rounded-full transition-all duration-700 ${scoreState.bar}`}
                      style={{
                        width: `${Math.max(0, Math.min(100, score))}%`,
                      }}
                    />
                  </div>

                  <div className="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <DiagnosticStat
                      label="Critical"
                      value={data.summary.critical}
                      tone="critical"
                    />

                    <DiagnosticStat
                      label="Warnings"
                      value={data.summary.warnings}
                      tone="warning"
                    />

                    <DiagnosticStat
                      label="Healthy"
                      value={data.summary.healthy}
                      tone="healthy"
                    />

                    <DiagnosticStat
                      label="Info"
                      value={data.summary.info}
                      tone="info"
                    />
                  </div>
                </div>
              </div>

              {/* AWS Environment */}
              <div className="rounded-2xl border border-white/10 bg-white/[0.025]">
                <div className="border-b border-white/10 px-5 py-5 sm:px-6">
                  <p className="text-xs uppercase tracking-[0.2em] text-[#777C85]">
                    AWS Environment
                  </p>

                  <div className="mt-2 flex items-center gap-2">
                    <div className="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.6)]" />

                    <h2 className="font-mono text-lg font-semibold text-[#B7D1C5]">
                      {data.region}
                    </h2>
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-3 p-5 sm:p-6">
                  <Resource
                    name="EC2"
                    value={data.infrastructure.ec2}
                  />

                  <Resource
                    name="Running EC2"
                    value={data.infrastructure.runningEC2}
                    tone="green"
                  />

                  <Resource
                    name="Stopped EC2"
                    value={data.infrastructure.stoppedEC2}
                    tone={
                      data.infrastructure.stoppedEC2 > 0
                        ? "amber"
                        : "green"
                    }
                  />

                  <Resource
                    name="S3"
                    value={data.infrastructure.s3}
                  />

                  <Resource
                    name="RDS"
                    value={data.infrastructure.rds}
                  />

                  <Resource
                    name="EKS"
                    value={data.infrastructure.eks}
                  />
                </div>

                <div className="border-t border-white/10 px-5 py-4 sm:px-6">
                  <div className="flex items-center gap-2 text-xs text-[#777C85]">
                    <Clock3 size={13} />
                    Last scan
                    <span className="text-[#9B9B9B]">
                      {new Date(data.scannedAt).toLocaleString()}
                    </span>
                  </div>
                </div>
              </div>

            </section>

            {/* Findings Header */}
            <section className="mt-8">
              <div className="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p className="text-xs uppercase tracking-[0.2em] text-[#777C85]">
                    Diagnostic Findings
                  </p>

                  <h2 className="mt-2 text-2xl font-bold">
                    What OpsMind Found
                  </h2>

                  <p className="mt-1 text-sm text-[#777C85]">
                    {data.summary.totalFindings} finding
                    {data.summary.totalFindings === 1 ? "" : "s"} from the
                    latest infrastructure scan.
                  </p>
                </div>

                <div className="flex items-center gap-2 text-xs text-emerald-400">
                  <span className="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.6)]" />
                  LIVE DIAGNOSTICS
                </div>
              </div>

              {sortedFindings.length === 0 ? (
                <div className="rounded-2xl border border-emerald-400/15 bg-emerald-400/[0.025] p-12 text-center">
                  <CheckCircle2 className="mx-auto h-10 w-10 text-emerald-400" />

                  <h3 className="mt-4 font-semibold">
                    No diagnostic findings
                  </h3>

                  <p className="mt-2 text-sm text-[#777C85]">
                    OpsMind did not return any infrastructure findings.
                  </p>
                </div>
              ) : (
                <div className="space-y-3">
                  {sortedFindings.map((finding) => {
                    const config = severityConfig(finding.severity);
                    const SeverityIcon = config.Icon;

                    return (
                      <button
                        key={finding.id}
                        onClick={() => setSelected(finding)}
                        className={`group w-full rounded-2xl border p-5 text-left transition hover:bg-white/[0.035] sm:p-6 ${config.background}`}
                      >
                        <div className="flex items-start gap-4">

                          <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-black/20">
                            <SeverityIcon
                              className={`h-5 w-5 ${config.icon}`}
                            />
                          </div>

                          <div className="min-w-0 flex-1">
                            <div className="flex flex-wrap items-center gap-2">
                              <h3 className="font-semibold">
                                {finding.title}
                              </h3>

                              <span
                                className={`rounded-lg border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide ${config.badge}`}
                              >
                                {config.label}
                              </span>

                              <span className="rounded-lg border border-white/10 bg-white/[0.025] px-2.5 py-1 text-[10px] uppercase tracking-wide text-[#777C85]">
                                {finding.service}
                              </span>
                            </div>

                            <p className="mt-2 max-w-4xl text-sm leading-6 text-[#9B9B9B]">
                              {finding.description}
                            </p>

                            <div className="mt-4 flex flex-wrap items-center gap-2">
                              <span className="rounded-lg border border-white/10 bg-black/20 px-2.5 py-1 text-[11px] text-[#777C85]">
                                {finding.affectedResources} affected
                              </span>

                              <span className="rounded-lg border border-white/10 bg-black/20 px-2.5 py-1 font-mono text-[11px] text-[#777C85]">
                                {finding.id}
                              </span>
                            </div>
                          </div>

                          <ChevronRight className="mt-2 hidden h-5 w-5 shrink-0 text-[#585858] transition group-hover:translate-x-1 group-hover:text-[#B7D1C5] sm:block" />

                        </div>
                      </button>
                    );
                  })}
                </div>
              )}
            </section>

            {/* Safe Operations */}
            <section className="mt-8 rounded-2xl border border-amber-400/20 bg-amber-400/[0.035] p-5 sm:p-6">
              <div className="flex items-start gap-4">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-400/20 bg-amber-400/10">
                  <ShieldCheck className="h-5 w-5 text-amber-400" />
                </div>

                <div>
                  <h2 className="font-semibold">
                    Safe Operations Mode
                  </h2>

                  <p className="mt-2 text-sm leading-6 text-[#9B9B9B]">
                    Cloud Doctor is diagnostic-only. This page reads AWS
                    infrastructure state and generates recommendations.
                    It does not stop, terminate, delete, restart or modify
                    AWS resources.
                  </p>
                </div>
              </div>
            </section>

            <footer className="mt-8 border-t border-white/10 pt-5 text-center text-xs text-[#585858]">
              Cloudnexaa Technologies · OpsMind Cloud Doctor
            </footer>
          </>
        )}
      </div>

      {/* Finding Details Modal */}
      {selected && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-4 backdrop-blur-sm"
          onClick={() => setSelected(null)}
        >
          <div
            className="w-full max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-[#0A0A0A] shadow-2xl"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="flex items-start justify-between gap-4 border-b border-white/10 p-5 sm:p-6">
              <div className="min-w-0">
                <p className="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-[#B7D1C5]">
                  {selected.id}
                </p>

                <h2 className="mt-2 text-xl font-bold sm:text-2xl">
                  {selected.title}
                </h2>
              </div>

              <button
                onClick={() => setSelected(null)}
                className="rounded-lg border border-white/10 p-2 text-[#777C85] transition hover:bg-white/10 hover:text-[#F6E8DF]"
                aria-label="Close finding details"
              >
                <X size={18} />
              </button>
            </div>

            <div className="max-h-[65vh] overflow-auto p-5 sm:p-6">
              {(() => {
                const config = severityConfig(selected.severity);
                const SeverityIcon = config.Icon;

                return (
                  <>
                    <div
                      className={`rounded-xl border p-4 ${config.background}`}
                    >
                      <div className="flex items-center gap-3">
                        <SeverityIcon
                          className={`h-5 w-5 ${config.icon}`}
                        />

                        <span
                          className={`rounded-lg border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide ${config.badge}`}
                        >
                          {config.label}
                        </span>

                        <span className="text-xs text-[#777C85]">
                          {selected.service}
                        </span>
                      </div>
                    </div>

                    <div className="mt-4 rounded-xl border border-white/10 bg-white/[0.025] p-4">
                      <p className="text-[10px] uppercase tracking-widest text-[#777C85]">
                        Diagnosis
                      </p>

                      <p className="mt-2 text-sm leading-6 text-[#9B9B9B]">
                        {selected.description}
                      </p>
                    </div>

                    <div className="mt-4 rounded-xl border border-[#B7D1C5]/15 bg-[#B7D1C5]/[0.035] p-4">
                      <p className="text-[10px] uppercase tracking-widest text-[#B7D1C5]">
                        Recommended Fix
                      </p>

                      <p className="mt-2 text-sm leading-6 text-[#9B9B9B]">
                        {selected.recommendation}
                      </p>
                    </div>

                    <div className="mt-4 grid grid-cols-2 gap-3">
                      <Resource
                        name="Service"
                        value={selected.service}
                      />

                      <Resource
                        name="Affected Resources"
                        value={selected.affectedResources}
                      />
                    </div>

                    <div className="mt-4 rounded-xl border border-white/10 bg-white/[0.025] p-4">
                      <p className="text-[10px] uppercase tracking-widest text-[#777C85]">
                        Remediation Mode
                      </p>

                      <p className="mt-2 text-sm font-semibold text-[#F6E8DF]">
                        {selected.remediationMode}
                      </p>
                    </div>
                  </>
                );
              })()}
            </div>

            <div className="border-t border-white/10 p-5 sm:p-6">
              <button
                onClick={() => setSelected(null)}
                className="w-full rounded-xl bg-[#F6E8DF] px-4 py-3 text-sm font-bold text-black transition hover:opacity-90"
              >
                Close Diagnostic
              </button>
            </div>
          </div>
        </div>
      )}
    </main>
  );
}

function DiagnosticStat({
  label,
  value,
  tone,
}: {
  label: string;
  value: number;
  tone: "critical" | "warning" | "healthy" | "info";
}) {
  const styles = {
    critical:
      "border-red-400/15 bg-red-400/[0.035] text-red-300",
    warning:
      "border-amber-400/15 bg-amber-400/[0.035] text-amber-300",
    healthy:
      "border-emerald-400/15 bg-emerald-400/[0.035] text-emerald-300",
    info:
      "border-cyan-400/15 bg-cyan-400/[0.035] text-cyan-300",
  };

  return (
    <div className={`rounded-xl border p-3 ${styles[tone]}`}>
      <p className="text-[11px] opacity-70">
        {label}
      </p>

      <p className="mt-2 text-2xl font-bold">
        {value}
      </p>
    </div>
  );
}

function Resource({
  name,
  value,
  tone = "default",
}: {
  name: string;
  value: number | string;
  tone?: "default" | "green" | "amber";
}) {
  const valueClass =
    tone === "green"
      ? "text-emerald-300"
      : tone === "amber"
        ? "text-amber-300"
        : "text-[#F6E8DF]";

  return (
    <div className="rounded-xl border border-white/10 bg-white/[0.025] p-4">
      <p className="text-[11px] text-[#777C85]">
        {name}
      </p>

      <p className={`mt-2 text-2xl font-bold ${valueClass}`}>
        {value}
      </p>
    </div>
  );
}
